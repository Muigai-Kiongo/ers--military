# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Session HMAC secret (min 32 characters recommended)
MTERS_SESSION_SECRET="mters-development-secret-key-32chars!"

# Tactical payload encryption key (AES-256-GCM data key)
MTERS_DATA_KEY="mters-field-encryption-key-32ch!"
